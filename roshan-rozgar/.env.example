# Copy to .env — every value is OPTIONAL. With none set the app runs fully
# offline: embedded Postgres (PGlite) + the deterministic AI stub.

# --- Database -------------------------------------------------------------
# Unset  -> embedded PGlite, persisted to .data/pglite (zero setup).
# Set    -> real Postgres. Needed for production and to watch the
#           one_active_job_per_worker index fire under a real race.
#
# Supabase: Project -> Connect -> "Session pooler" string. Use the POOLER string,
# not "Direct connection": the direct host is IPv6-only and fails on most home
# networks. Replace [YOUR-PASSWORD]. Looks like:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_URL=
# PGLITE_DATA_DIR=.data/pglite

# --- Supabase Storage (voice notes + work photos) --------------------------
# Unset -> uploads are saved to .data/uploads and served by /api/upload/:name.
# Project -> Settings -> API: the project URL, and the SECRET / service_role key.
# That key is server-only: never expose it to the browser or commit it.
# The bucket is created automatically (public) on first upload.
# Bare project URL only, no path (not the ".../rest/v1/" address).
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=roshan-media

# --- ElevenLabs (Urdu speech-to-text + text-to-speech) ---------------------
# Scribe leads the transcribe chain (Whisper, then the stub, are fallbacks);
# /api/ai/speak reads prompts aloud. Keys: elevenlabs.io -> Developers -> API keys.
# ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v1
# ELEVENLABS_TTS_MODEL=eleven_v3
# Free plan: premade voices only (library voices return 402). Default is "Alice".
# ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2

# --- AI providers (chain: anthropic -> openai -> stub) ---------------------
# Reasoning, extraction, classification, translation, summaries, vision.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MODEL_HEAVY=claude-opus-5-5

# Urdu speech-to-text (Whisper).
# OPENAI_API_KEY=
# OPENAI_STT_MODEL=whisper-1

# Reserved: the key is read but no Gemini provider is implemented yet.
# GEMINI_API_KEY=

# --- Search tuning ---------------------------------------------------------
# SEARCH_DEFAULT_RADIUS_KM=8
# SEARCH_MAX_RESULTS=20
